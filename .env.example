# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# This service is the SOLE owner of broker order-routing credentials. Broker
# secrets (Liberator PIN/OTP session, the Streaming Pro bridge api-key) live
# ONLY in this gitignored `.env` — never in the gateway, a strategy, or the repo.

# ---- Application ----
EXECUTION_ENGINE_LOG_LEVEL=INFO
# Public/read-only mode: order-submission endpoints are disabled. Owner mode
# (false) is the docker-compose.private.yml overlay. Default safe = true.
EXECUTION_ENGINE_PUBLIC_MODE=true

# ---- Rollout stage (safety ladder) ----
# sim | paper | micro_live | live  — default to the safest stage. Live order
# routing is gated and disabled by default; the kill-switch overrides every stage.
EXECUTION_ENGINE_STAGE=sim

# ---- Global kill-switch (hard stop; overrides everything) ----
EXECUTION_ENGINE_KILL_SWITCH_ENGAGED=false

# ---- Durable order store (quant-infra-db / Postgres) ----
EXECUTION_ENGINE_PG_DSN=postgresql://quant:quant@quant-postgres:5432/db_execution

# ---- Own Redis sidecar (dedupe / single-flight / rate-limit) ----
EXECUTION_ENGINE_REDIS_URL=redis://execution-redis:6379/0

# ---- Optional read API key (auth gate) ----
# EXECUTION_ENGINE_API_KEY=

# ---- PTRM pre-trade risk caps (D11; checked before any venue I/O) ----
# EXECUTION_ENGINE_RISK_MAX_ORDER_QTY=1000
# EXECUTION_ENGINE_RISK_MAX_ORDER_VALUE=1000000
# EXECUTION_ENGINE_RISK_MAX_ORDERS_PER_SECOND=5
# Legacy Phase-2 burst window (kept so old .env files load; no longer read —
# the Phase-6 guard uses EXECUTION_ENGINE_DUPLICATE_BURST_WINDOW_SECONDS below).
# EXECUTION_ENGINE_RISK_DUPLICATE_BURST_WINDOW_SECONDS=2

# ---- Per-account PTRM caps (Phase 6 / A1) ----
# JSON maps account -> cap. An account present here binds to its own cap; an
# account absent falls back to the global RISK_MAX_* caps above (never a silent
# skip). Enforced in EVERY stage, including sim. Notional is Decimal-as-string.
# EXECUTION_ENGINE_ACCOUNT_MAX_NOTIONAL={"ACC-1": "500000", "ACC-2": "2000000"}
# EXECUTION_ENGINE_ACCOUNT_MAX_QTY={"ACC-1": 500, "ACC-2": 2000}

# ---- Price-band advisory pre-trade check (Phase 6 / A2) ----
# When enabled AND EXECUTION_ENGINE_MARKET_DATA_BASE_URL is set, a LIMIT order
# whose price deviates from the symbol's last close by more than MAX_PCT percent
# is rejected (422 price_band_exceeded). MARKET orders bypass; a market-data
# fetch failure is advisory (logs a WARNING and passes the order). Default OFF.
# EXECUTION_ENGINE_PRICE_BAND_ENABLED=false
# EXECUTION_ENGINE_PRICE_BAND_MAX_PCT=10.0

# ---- Unified duplicate-burst guard (Phase 6 / A3) ----
# Blocks a second order with the same economic fingerprint
# (account, symbol, side, quantity, order_type, price) under a DIFFERENT
# client_order_id within the window (409 duplicate_burst_detected). Same-cid
# resends are handled by idempotency dedupe, never here. DEFAULT ON (a hardening
# phase must not silently disable an active guard); set false to disable.
# EXECUTION_ENGINE_DUPLICATE_BURST_GUARD_ENABLED=true
# EXECUTION_ENGINE_DUPLICATE_BURST_WINDOW_SECONDS=5

# ---- Idempotent-submit single-flight lock ----
# EXECUTION_ENGINE_SUBMIT_LOCK_TTL_SECONDS=10
# EXECUTION_ENGINE_SUBMIT_LOCK_WAIT_MS=300

# ---- SimAdapter (deterministic paper fills) ----
# Reference price for MARKET/MTL/ATO/ATC orders that carry no price.
# EXECUTION_ENGINE_SIM_DEFAULT_FILL_PRICE=100

# ---- Broker: Liberator — engine-side adapter config ----
# LiberatorAdapter composes the bundled liberator-trading-api over HTTP (D9).
# Target is the internal service hostname on quant-network (port 8200 = liberator's
# config/system.yaml api.port). Never localhost.
# EXECUTION_ENGINE_LIBERATOR_BASE_URL=http://liberator-trading-api:8200/api/v1
# EXECUTION_ENGINE_LIBERATOR_API_KEY=    # must equal the upstream API_KEY below (api-key header)
# EXECUTION_ENGINE_LIBERATOR_PIN=        # per-order trading PIN — secret, never commit/log
# EXECUTION_ENGINE_LIBERATOR_HEARTBEAT_INTERVAL_SECONDS=30
# EXECUTION_ENGINE_LIBERATOR_CIRCUIT_BREAKER_THRESHOLD=3
# EXECUTION_ENGINE_LIBERATOR_RECONCILE_INTERVAL_SECONDS=12

# Post-placement handle recovery (TK-0423). The Liberator place-ack carries NO orderNo
# at all, so without this the venue handle only appears at the next reconcile pass —
# ~6 s on average at the 12 s default. Both numbers below are floors read off
# measurement, not preferences:
#   CADENCE_MS  ~= the bridge read itself (200-244 ms). Polling faster cannot produce a
#                  fresher answer; it queues reads on a venue session SHARED with the
#                  capture plane, whose data is not backfillable.
#   DEADLINE_MS  = budget measured from the SUBMIT timestamp, not the ack: the venue
#                  holds the answer at 567-752 ms while our placement round-trip is
#                  959-1175 ms, so the first attempt normally succeeds and the budget is
#                  for the tail. On expiry the submit reports resolution=pending/unknown
#                  rather than blocking. Raising it trades caller latency for a slightly
#                  better hit rate; it never makes the answer arrive sooner.
#   MIN_POLLS    = the RETRY FLOOR (TK-0426). The deadline below is anchored on the
#                  SUBMIT timestamp, so the placement round-trip (896-1175 ms) sits
#                  INSIDE it and used to leave ~1 retry — and none at all if the
#                  placement was slow. That made `unknown` ("the venue could not be
#                  read") reachable because OUR OWN call was slow, i.e. the expensive
#                  signal firing for a cause unrelated to what it detects. The floor is
#                  checked FIRST and ANDed, so the ceiling can never cut below it.
# EXECUTION_ENGINE_HANDLE_RECOVERY_CADENCE_MS=250
# EXECUTION_ENGINE_HANDLE_RECOVERY_MIN_POLLS=3
# EXECUTION_ENGINE_HANDLE_RECOVERY_DEADLINE_MS=1500
# Venue-facing placement rate cap (Phase 6 / D2). A token bucket on place() ONLY
# (cancel/heartbeat/reconciler fetches are unthrottled). On exhaustion place()
# AWAITS (back-pressure) — never drops, never raises. Distinct from the PTRM
# EXECUTION_ENGINE_RISK_MAX_ORDERS_PER_SECOND gate. 0 = unlimited (disabled).
# EXECUTION_ENGINE_LIBERATOR_POST_RATE_LIMIT=5
#   default 5 / allowed int>=0 / effect: outbound liberator place() requests/second

# ---- Bundled Liberator upstream (docker-compose.liberator.yml overlay only) ----
# These are read by the liberator-trading-api container (env_file: .env). Only needed
# when you bring up the overlay; the public/sim default never starts liberator.
# LIBERATOR_USERNAME=                    # Liberator login username — secret
# LIBERATOR_PASSWORD=                    # Liberator login password — secret
# TEL_NO=                                # phone number for OTP SMS (field alias TEL_NO)
# API_KEY=                               # liberator's own webhook/API key — secret
# LIBERATOR_PIN=                         # liberator-side trading PIN — secret
# REDIS_PASSWORD=                        # optional; the bundled liberator-redis has none

# ---- Broker: Streaming Pro (Phase 8 — the retail bridge, HTTP-composed) ----
# The StreamingProAdapter composes the settrade-streaming-api bridge over plain HTTP
# (mirrors Liberator). The engine holds ONLY the bridge's api-key + base_url — the
# BRIDGE owns USERNAME/PASSWORD/PIN and stamps the PIN itself, so the engine sends
# NO PIN. Set these in owner mode (+ bring up docker-compose.streaming.yml).
# EXECUTION_ENGINE_STREAMING_PRO_BASE_URL=http://streaming-pro-api:8000/api/v1
# EXECUTION_ENGINE_STREAMING_PRO_API_KEY=  # must equal the bridge's STREAMING_PRO_API_KEY — secret
# EXECUTION_ENGINE_STREAMING_PRO_HEARTBEAT_INTERVAL_SECONDS=30
# EXECUTION_ENGINE_STREAMING_PRO_CIRCUIT_BREAKER_THRESHOLD=3
# EXECUTION_ENGINE_STREAMING_PRO_RECONCILE_INTERVAL_SECONDS=12
# EXECUTION_ENGINE_STREAMING_PRO_POST_RATE_LIMIT=5
#   default 5 / allowed int>=0 / effect: outbound place requests/second to the bridge (0 = unlimited)
# The bridge's OWN creds (held by the bridge container, via this same .env / its env_file):
# STREAMING_PRO_API_KEY=                   # owner api-key (engine must match the value above)
# STREAMING_PRO_USERNAME=                  # retail login — secret (BRIDGE-held, never the engine's)
# STREAMING_PRO_PASSWORD=                  # retail password — secret (BRIDGE-held)
# STREAMING_PRO_PIN=                       # trading PIN — secret (BRIDGE-held; stamped per order by the bridge)
# STREAMING_PRO_TFEX_ACCOUNT_NO=           # TFEX portfolio (BRIDGE-held)
# STREAMING_PRO_SET_ACCOUNT_NO=            # SET portfolio (BRIDGE-held; SET != TFEX)

# ---- Order book service (Phase 5 — normalized, read-only L2 cache) ----
# A Liberator-WebSocket-fed in-engine cache for paper-fill realism and
# spread/arbitrage reads. The whole service defaults OFF: nothing connects, the
# engine behaves exactly as before until you opt in. The endpoints carry no order
# data/credential (public-readable). The provider activates only when its creds
# are present: Liberator (the sole provider) needs LIBERATOR_API_KEY.
#
# EXECUTION_ENGINE_ORDER_BOOK_ENABLED=false
#   default false / allowed true|false / effect: master switch for the whole service
# EXECUTION_ENGINE_ORDER_BOOK_PRIMARY_PROVIDER=liberator
#   default liberator / allowed liberator / effect: default primary feed
# EXECUTION_ENGINE_ORDER_BOOK_SYMBOL_OVERRIDES={}
#   default {} / allowed JSON map symbol->provider / effect: pin symbols to a provider
#   (e.g. '{"AOT": "liberator"}'); an override never fails over
# EXECUTION_ENGINE_ORDER_BOOK_FAILOVER_ERROR_THRESHOLD=3
#   default 3 / allowed int>=1 / effect: consecutive active-provider errors before switch
# EXECUTION_ENGINE_ORDER_BOOK_FAILOVER_WINDOW_SECONDS=30
#   default 30 / allowed int>=1 / effect: sliding window the error count is measured over
# EXECUTION_ENGINE_ORDER_BOOK_CACHE_MAX_AGE_SECONDS=5
#   default 5 / allowed int>=1 / effect: a snapshot older than this reads as absent (stale)
# EXECUTION_ENGINE_ORDER_BOOK_CACHE_MAX_SYMBOLS=500
# Optional extra CA PEM path for the Liberator WS host (venue serves an
# incomplete TLS chain; the public GlobalSign intermediate is bundled — set
# this only if the venue rotates its chain). Verification is never disabled.
# EXECUTION_ENGINE_ORDER_BOOK_LIBERATOR_EXTRA_CA_PEM=/path/to/intermediate.pem
#   default 500 / allowed int>=1 / effect: LRU capacity (least-recently-touched evicted)
# EXECUTION_ENGINE_MARKET_DATA_BASE_URL=
#   default unset / allowed URL / effect: sim fill-price fallback hop 2 (last close)
# EXECUTION_ENGINE_MARKET_DATA_API_KEY=
#   default unset / allowed secret / effect: X-API-Key for the marketdata fallback (NEVER logged)
# EXECUTION_ENGINE_STREAM_KEEPALIVE_SECONDS=15
#   default 15 / allowed int>=1 / effect: SSE keep-alive comment interval
# EXECUTION_ENGINE_STREAM_RING_BUFFER_SIZE=1024
#   default 1024 / allowed int>=1 / effect: order-update stream replay window
# EXECUTION_ENGINE_STREAM_SUBSCRIBER_QUEUE_SIZE=256
#   default 256 / allowed int>=1 / effect: per-subscriber back-pressure bound (drop-oldest)

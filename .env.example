# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# This service is the SOLE owner of broker order-routing credentials. Broker
# secrets (Liberator PIN/OTP session, Settrade app_id/app_secret/app_code) live
# ONLY in this gitignored `.env` — never in the gateway, a strategy, or the repo.

# ---- Application ----
EXECUTION_ENGINE_LOG_LEVEL=INFO
# Public/read-only mode: order-submission endpoints are disabled. Owner mode
# (false) is the docker-compose.private.yml overlay. Default safe = true.
EXECUTION_ENGINE_PUBLIC_MODE=true

# ---- Rollout stage (safety ladder) ----
# sim | paper | micro_live | live  — default to the safest stage. Live order
# routing is gated and disabled by default; the kill-switch overrides every stage.
EXECUTION_ENGINE_STAGE=sim

# ---- Global kill-switch (hard stop; overrides everything) ----
EXECUTION_ENGINE_KILL_SWITCH_ENGAGED=false

# ---- Durable order store (quant-infra-db / Postgres) ----
EXECUTION_ENGINE_PG_DSN=postgresql://quant:quant@quant-postgres:5432/db_execution

# ---- Own Redis sidecar (dedupe / single-flight / rate-limit) ----
EXECUTION_ENGINE_REDIS_URL=redis://execution-redis:6379/0

# ---- Optional read API key (auth gate) ----
# EXECUTION_ENGINE_API_KEY=

# ---- Broker: Liberator (LiberatorAdapter composes the existing service over HTTP) ----
# EXECUTION_ENGINE_LIBERATOR_BASE_URL=http://liberator-trading-api:8000/api/v1
# EXECUTION_ENGINE_LIBERATOR_PIN=        # trading PIN — secret, never commit/log

# ---- Broker: Settrade Open API v2 (SettradeAdapter owns its OAuth session) ----
# EXECUTION_ENGINE_SETTRADE_APP_ID=
# EXECUTION_ENGINE_SETTRADE_APP_SECRET=  # secret, never commit/log
# EXECUTION_ENGINE_SETTRADE_APP_CODE=
# EXECUTION_ENGINE_SETTRADE_BROKER_ID=
# EXECUTION_ENGINE_SETTRADE_ACCOUNT_NO=
# EXECUTION_ENGINE_SETTRADE_PIN=         # secret, never commit/log
